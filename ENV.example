# Exemple de configuration. Le vrai fichier s'appelle ENV (ignoré par Git) et
# DEMARRAGE.bat le charge avant de lancer le watchdog. Ne jamais y mettre de
# valeur réelle ici.

# Dead man's switch (Healthchecks.io). Désactivé tant que KATECHON_HEALTHCHECK
# ne vaut pas 1. Le bot pinge l'URL après chaque cycle de santé réussi (60 s)
# et envoie <URL>/fail à l'arrêt propre. Régler le check sur une période de
# 1 min et une grâce de 5 min.
KATECHON_HEALTHCHECK=0
HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid-du-check>

# Remontée des erreurs (@healed et erreurs financières avalées). Désactivé tant
# que KATECHON_GITHUB_ISSUES ne vaut pas 1. Une issue par empreinte d'erreur
# (type + fichier + ligne), puis des commentaires "+N occurrence(s)". Le texte
# publié est masqué (secrets, numéros, montants). Jeton GitHub à granularité
# fine, limité à ce dépôt, permission Issues : lecture et écriture.
KATECHON_GITHUB_ISSUES=0
GITHUB_TOKEN=github_pat_<jeton>
GITHUB_REPO=Barack-zero-to-one/katechon-os

# Dead letter queue des opérations financières en échec : écrite dans
# logs/dead_letter.jsonl puis rejouée dans la table dead_letter_queue au
# cycle de santé suivant. Désactivée tant que KATECHON_DLQ ne vaut pas 1.
KATECHON_DLQ=0
